# Copy to .env. Never put real credentials in Git or a buyer archive.
# Opt-in Vercel/browser-only USA/USD demo. Exact true is required at BUILD time.
# false/absent retains the Express/MongoDB architecture; independent of STORE_MODE.
NEXT_PUBLIC_BROWSER_DEMO=false
STORE_MODE=demo
MONGODB_URI=
FRESHCART_DATA_DIR=.data
API_HOST=127.0.0.1
API_PORT=4100
API_URL=http://127.0.0.1:4100
WEB_ORIGIN=http://127.0.0.1:3000
PUBLIC_API_URL=

# Production: explicit STORE_MODE=production, authenticated replica-set/Atlas URI,
# HTTPS WEB_ORIGIN/PUBLIC_API_URL and the same random 32+ character secret on all APIs.
CHECKOUT_IDENTITY_SECRET=
CHECKOUT_RATE_MAX=30
MAX_OUTSTANDING_COD=3
# Blank trusts no forwarded IP headers. Use only actual upstream proxy IP/CIDRs.
TRUSTED_PROXY_CIDRS=

# Optional tests create/remove an isolated freshcart_test_* DB on this test service.
MONGODB_TEST_URI=

# Optional reset mail; no tokens are exposed in responses or logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional hosted payment adapter: BDT / BD only. Empty credentials disable it.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_LIVE=false
# PUBLIC_API_URL is a public HTTPS origin WITHOUT /api.
# Production compose also needs STORE_DOMAIN=shop.your-domain.example
