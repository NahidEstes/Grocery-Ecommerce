# Leave blank to use the bundled sample catalog. Never commit real credentials.
MONGODB_URI=
API_PORT=4100
API_URL=http://127.0.0.1:4100
WEB_ORIGIN=http://127.0.0.1:3000

# MongoDB must support transactions (Atlas or a replica set).
# Use a separate test server / credentials for optional Mongo integration checks.
MONGODB_TEST_URI=

# Password reset email. No reset link is exposed in logs or API responses.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# SSLCOMMERZ hosted checkout. Start in sandbox; leave credentials empty to disable.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_LIVE=false
# Public HTTPS API base, WITHOUT /api. Required for gateway callbacks / IPN.
PUBLIC_API_URL=
# For hosted operation also set WEB_ORIGIN to the public HTTPS storefront URL.
# Set NODE_ENV=production in the hosting environment. Keep the API behind Next.js.
