{
  "name": "freshcart-grocery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "next dev --hostname 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "build": "next build",
    "start": "concurrently -k -n api,web \"npm:start:api\" \"npm:start:web\"",
    "start:web": "next start --hostname 127.0.0.1",
    "start:api": "tsx server/index.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx --test tests/*.test.ts",
    "seed": "tsx server/seed.ts",
    "admin:promote": "tsx server/create-admin.ts",
    "test:mongo": "tsx --test tests/mongo.integration.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^1.60.0",
    "mongoose": "^9.11.2",
    "next": "^16.4.2",
    "nodemailer": "^10.1.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
